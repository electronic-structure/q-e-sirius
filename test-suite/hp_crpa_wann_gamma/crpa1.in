   pert_basis = 'wannier'
   wannier_seedname = 'diam'
   wan_dist_thr = 6.d-4
   wan_dist_thr_mels = 6.d-4
   lrpa = .false.
   tr2 = 1.d-16
   reduce_io = .true.
   qplot = .true.
/

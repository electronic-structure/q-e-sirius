&CONTROL
    calculation  = 'scf'
    prefix       = 'MoS2'
    restart_mode = 'from_scratch'
    pseudo_dir   = '../../pseudo/'
    outdir       = './temp/'
/
&SYSTEM
    ibrav       = 4
    celldm(1)   = 6.02019
    celldm(3)   = 5.33626
    ntyp        = 2
    nat         = 3
    ecutwfc     = 25.0
    nbnd        = 17
    ! One hole per cell: metallic, E_F crosses bands 12 and 13
    tot_charge  = +1.0
    occupations = 'smearing'
    smearing    = 'gaussian'
    degauss     = 0.02
    assume_isolated = '2D'
    nosym = .true.
    noinv = .true.
/
&ELECTRONS
    conv_thr       = 1.0d-12
    diago_full_acc = .true.
/
ATOMIC_SPECIES
Mo  95.962  Mo-PBE.upf
S   32.065  S-PBE.upf

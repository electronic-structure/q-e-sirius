&control
    calculation = 'scf'
    restart_mode = 'from_scratch',
    prefix = 'Si',
    pseudo_dir = '../../pseudo/',
    outdir = './out'
    verbosity = 'high'
/
&system
    ibrav = 2,
    celldm(1) = 10.263101844
    nat = 2, ntyp = 1,
    ecutwfc = 25.0,
    ecutrho = 200.0,


/
&electrons
    diagonalization = 'david'
    diago_full_acc = .true.
    mixing_beta = 0.7
    conv_thr = 1.0d-11
/
&ions
/
ATOMIC_SPECIES
Si 28.085 Si.pbe-nl-rrkjus_psl.1.0.0.UPF
ATOMIC_POSITIONS crystal
Si 0.00 0.00 0.00
Si 0.25 0.25 0.25
K_POINTS automatic
 3 3 3 0 0 0

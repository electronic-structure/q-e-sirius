 0.000000000   5.131550922   5.131550922
-5.131550922   5.131550922   0.000000000
end unit_cell_cart

begin atoms_frac
Si  0.00  0.00  0.00
Si  0.25  0.25  0.25
end atoms_frac

mp_grid = 3 3 3


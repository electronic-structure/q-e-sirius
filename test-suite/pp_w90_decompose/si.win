! Standalone chain: wannier90.x -pp, pw2wannier90.x, wannier90.x, then
! pw2wannier90.x wan_mode = 'decompose', which reads back si.nnkp,
! si_u.mat, si_u_dis.mat and si_centres.xyz.

num_bands = 12
num_wann  = 8

dis_win_max  = 17.0
dis_froz_max =  6.5

dis_num_iter = 10
num_iter     = 10

num_print_cycles = 10

guiding_centres = .true.

! read back by the decompose step
write_u_matrices = .true.
write_xyz = .true.

begin projections
Si : sp3
end projections

begin unit_cell_cart
bohr

input_description -distribution {Quantum ESPRESSO} -package PWscf -program hp.x {

    toc {}

    intro {
	@b {Input data format:} { } = optional, [ ] = it depends, # = comment

	@b {Structure of the input data:}
	===============================================================================

	@b &INPUTHP
	   ...
	@b /

	[ @b &CRPA           ]   ( read only when @ref method = 'cRPA' )
	[    ...             ]
	[ @b /               ]

	[ nqaux              ]   ( q-point card, read only when @ref qplot = .true. )
	[ xq(1) xq(2) xq(3) wq ]
	[ ...                ]

    }

    namelist INPUTHP {

        var prefix -type CHARACTER {
            default { 'pwscf' }
            info {
                Prepended to input/output filenames; must be the same
                used in the calculation of unperturbed system.
            }
        }

        var outdir -type CHARACTER {
            default -kind conditional {
                case -test {ESPRESSO_TMPDIR is set} { from_environment }
                case { './' }
            }
            info {
		Directory containing input, output, and scratch files;
                must be the same as specified in the calculation of
                the unperturbed system.
            }
        }

        var method -type CHARACTER {
            default { 'LR-cDFT' }
            options {
                info {
                    Method used by hp.x. It selects which quantity is
                    computed from the linear response of the system.
                }
                opt -val 'LR-cDFT' {
                    Linear-response theory calculation of the Hubbard
                    parameters U (and V), as described in
                    PRB 98, 085127 (2018) and PRB 103, 045141 (2021).
                    This is the standard HP behavior.
                }
                opt -val 'cRPA' {
                    Constrained random phase approximation (cRPA):
                    computes screened (and bare) Coulomb interaction
                    matrix elements in a basis of bands or Wannier
                    functions. When @ref method = 'cRPA' the additional
                    namelist @b &CRPA (see below) is read after @b &INPUTHP,
                    and most of the LR-cDFT-specific keywords of @b &INPUTHP
                    are ignored. The q-point grid (@ref nq1, @ref nq2,
                    @ref nq3), the DFPT-iteration knobs (@ref niter_max,
                    @ref nmix, @ref alpha_mix, @ref thresh_init) and the
                    q-range selection (@ref start_q, @ref last_q) of
                    @b &INPUTHP are still used.
                }
            }
        }

        var iverbosity -type INTEGER {
            default { 1 }
            options {
                opt -val 1 { minimal output }
                opt -val 2 {
                    as above + symmetry matrices, final response
                    matrices chi0 and chi1 and their inverse matrices,
                    full U matrix
                }
                opt -val 3 {
                    as above + various detailed info about the NSCF
                    calculation at k and k+q
                }
                opt -val 4 {
                    as above + response occupation matrices at every
                    iteration and for every q point in the star
                }
            }
        }

        var max_seconds  -type REAL {
            default { 1.d7 }
            dimensionality { time }
            units { s }
            info {
             Maximum allowed run time before the job stops smoothly.
            }
        }

        vargroup -type INTEGER {
            var nq1
            var nq2
            var nq3
            default { 1 }
            info {
                Parameters of the Monkhorst-Pack grid (no offset).
                Same meaning as for nk1, nk2, nk3 in the input of pw.x.
            }
        }

        var skip_equivalence_q -type LOGICAL {
            default { .false. }
            info {
                If .true. then the HP code will skip the equivalence
                analysis of q points, and thus the full grid of q points
                will be used. Otherwise the symmetry is used to determine
                equivalent q points (star of q), and then perform
                calculations only for inequivalent q points.
            }
        }

        var determine_num_pert_only -type LOGICAL {
            default { .false. }
            see { find_atpert }
            info {
              If .true. determines the number of perturbations
              (i.e. which atoms will be perturbed) and exits smoothly 
              without performing any calculation. For DFT+U+V, it also 
              determines the indices of inter-site couples.
            }
        }

        var determine_q_mesh_only -type LOGICAL {
            default { .false. }
            see { perturb_only_atom  }
            info {
              If .true. determines the number of q points
              for a given perturbed atom and exits smoothly.
              This keyword can be used only if perturb_only_atom
              is set to .true.
            }
        }

        var find_atpert -type INTEGER {
            default { 1 }
            options {
                info {
                    Method for searching of atoms which must be perturbed.
                }
                opt -val 1 {
                    Find how many inequivalent Hubbard atoms there are
                    by analyzing unperturbed occupations.
                }
                opt -val 2 {
                    Find how many Hubbard atoms to perturb based on
                    how many different Hubbard atomic types there are.
                    Warning: atoms which have the same type but which
                    are inequivalent by symmetry or which have different
                    occupations will not be distinguished in this case
                    (use option 1 or 3 instead).
                }
                opt -val 3 {
                    Find how many inequivalent Hubbard atoms
                    there are using symmetry. Atoms which have the
                    same type but are not equivalent by symmetry will
                    be distinguished in this case.
                }
                opt -val 4 {
                    Perturb all Hubbard atoms (the most expensive option).
                }
             }
        }

        var docc_thr  -type REAL {
            default { 5.D-5 }
            dimensionality { dimensionless }
            info {
                Threshold for a comparison of unperturbed occupations
                which is needed for the selection of atoms which must 
                be perturbed. Can be used only when @ref find_atpert = 1.
            }
        }

        dimension skip_type -start 1 -end ntyp -type LOGICAL {
            default { .false. }
            see { equiv_type }
            info {
              @ref skip_type(i), where i runs over types of atoms.
              If @ref skip_type(i)=.true. then no linear-response 
              calculation will be performed for the i-th atomic type: 
              in this case @ref equiv_type(i) must be specified, otherwise 
              the HP code will stop. This option is useful if the 
              system has atoms of the same type but opposite spin 
              pollarizations (anti-ferromagnetic case).
              This keyword cannot be used when @ref find_atpert = 1.
            }
        }

        dimension equiv_type -start 1 -end ntyp -type INTEGER {
            default { 0 }
            see { skip_type }
            info {
             @ref equiv_type(i), where i runs over types of atoms.
             @ref equiv_type(i)=j, will make type i equivalent to type j 
             (useful when nspin=2). Such a merging of types is done 
             only at the post-processing stage.
             This keyword cannot be used when @ref find_atpert = 1.
            }
        }

        dimension perturb_only_atom -start 1 -end ntyp -type LOGICAL {
            default { .false. }
            see { compute_hp }
            info {
             If @ref perturb_only_atom(i)=.true. then only the i-th 
             atom will be perturbed and considered in the run. 
             This variable is useful when one wants to split 
             the whole calculation on parts.

             @b Note: this variable has a higher priority than @ref skip_type.
            }
        }

        var start_q  -type INTEGER {
            default { 1 }
            see { last_q, sum_pertq }
            info {
                 Computes only the q points from @ref start_q to @ref last_q.

                 @b IMPORTANT: @ref start_q must be smaller or equal to 
                 the total number of q points found.
            }
        }

        var last_q  -type INTEGER {
            default -kind computed { internal }
            see { start_q, sum_pertq }
            info {
                 Computes only the q points from @ref start_q to @ref last_q.
                 By default it is set internally to the total number of q points.

                 @b IMPORTANT: @ref last_q must be smaller or equal to
                 the total number of q points found.
            }
        }

        var sum_pertq -type LOGICAL {
            default { .false. }
            see { start_q, last_q, perturb_only_atom }
            info {
             If it is set to .true. then the HP code will collect
             pieces of the response occupation matrices for all 
             q points. This variable should be used only when 
             @ref start_q, @ref last_q and @ref perturb_only_atom are used.
            }
        }

        var compute_hp -type LOGICAL {
            default { .false. }
            see { perturb_only_atom }
            info {
             If it is set to .true. then the HP code will collect
             pieces of the chi0 and chi matrices (which must have 
             been produced in previous runs) and then compute 
             Hubbard parameters. The HP code will look for files 
             tmp_dir/HP/prefix.chi.i.dat. Note that all files 
             prefix.chi.i.dat (where i runs over all perturbed 
             atoms) must be placed in one folder tmp_dir/HP/. 
             @ref compute_hp=.true. must be used only when the 
             calculation was parallelized over perturbations.
            }
        }

        var conv_thr_chi  -type REAL {
            default { 1.D-5 }
            dimensionality { dimensionless }
            info {
                Convergence threshold for the response function chi,
                which is defined as a trace of the response 
                occupation matrix.
            }
        }

        var thresh_init  -type REAL {
            default { 1.D-14 }
            dimensionality { dimensionless }
            info {
                Initial threshold for the solution of the linear 
                system (first iteration). Needed to converge the 
                bare (non-interacting) response function chi0. 
                The specified value will be multiplied by the 
                number of electrons in the system.
            }
        }
        
        var ethr_nscf  -type REAL {
            default { 1.D-11 }
            dimensionality { dimensionless }
            info {
                Threshold for the convergence of eigenvalues during 
                the iterative diagonalization of the Hamiltonian in 
                the non-self-consistent-field (NSCF) calculation at  
                k and k+q points. Note, this quantity is NOT extensive. 
            }
        }
         
	var niter_max -type INTEGER {
	    default { 100 }
	    info {
		Maximum number of iterations in the iterative
                solution of the linear-response Kohn-Sham equations. 
	    }
	}

	var alpha_mix(i)  -type REAL {
	    default -kind conditional {
		case -test {i==1} { 0.3 }
		case { 0.0 }
	    }
	    dimensionality { dimensionless }
	    info {
		Mixing parameter (for the i-th iteration) for updating
                the response SCF potential using the modified Broyden
                method. See: D.D. Johnson, PRB 38, 12807 (1988).
	    }
	}

	var nmix   -type INTEGER {
	    default { 12 }
	    info {
                Number of iterations used in potential mixing
                using the modified Broyden method. See:
                D.D. Johnson, PRB 38, 12807 (1988).
            }
	}

        var num_neigh   -type INTEGER {
            default { 6 }
            info {
                Number of nearest neighbors of every Hubbard atom which 
                will be considered when writting Hubbard V parameters to 
                the file parameters.out, which can be used in the 
                subsequent DFT+U+V calculation. This keyword is used only 
                for DFT+U+V (post-processing stage).
            }
        }

        var lmin   -type INTEGER {
            default { 2 }
            options {
                info {
                    Minimum value of the orbital quantum number of the Hubbard
                    atoms starting from which (and up to the maximum l in the
                    system) Hubbard V will be written to the file parameters.out.
                    @ref lmin refers to the orbital quantum number of the atom
                    corresponding to the first site-index in Hubbard_V(:,:,:).
                    This keyword is used only for DFT+U+V and only
                    in the post-processing stage.
                }
                opt -val 0 {
                    Include V involving s states (and all higher l) of the
                    first-site atom when writing to parameters.out.
                }
                opt -val 1 {
                    Include V involving p states (and all higher l) of the
                    first-site atom: e.g. V between oxygen (with p states)
                    and its neighbors, as well as V between transition
                    metals (with d states) and their neighbors, will be
                    written to parameters.out.
                }
                opt -val 2 {
                    Include V involving d states (and all higher l) of the
                    first-site atom: e.g. only V between transition metals
                    (with d states) and their neighbors will be written to
                    parameters.out.
                }
                opt -val 3 {
                    Include V involving only f states of the first-site atom
                    when writing to parameters.out.
                }
            }
        }

        var rmax   -type REAL {
            default { 100.D0 }
            dimensionality { length }
            units { bohr }
            info {
                Maximum distance between two atoms to search
                neighbors (used only at the postprocessing step for 
                DFT+U+V). This keyword is useful when there 
                are e.g. defects in the system.
            }
        }

        var dist_thr   -type REAL {
            default { 6.D-4 }
            dimensionality { length }
            units { bohr }
            info {
                Threshold for comparing inter-atomic distances
                when reconstructing the missing elements of the response 
                susceptibility in the post-processing step.
            }
        }

        var no_metq0 -type LOGICAL {
            default { .false. }
            info {
                If .true. the metallic response term at q=0 is ignored
                (i.e. the last term in Eq. (22) in PRB 103, 045141 (2021)).
                This is useful for magnetic insulators to avoid the divergence
                of the calculation.
            }
        }

}

    namelist CRPA {

        label {
            This namelist is read only when @ref method = 'cRPA'. It
            controls the constrained-RPA calculation of the (screened and
            bare) Coulomb interaction matrix elements. It must appear right
            after the @b &INPUTHP namelist in the input file.
        }

        var pert_basis -type CHARACTER {
            status { REQUIRED }
            options {
                info {
                    Basis in which the perturbations (and the resulting
                    Coulomb matrix elements) are defined.
                }
                opt -val 'bands' {
                    Use products of Bloch bands with band indices from
                    @ref pert_bands_min to @ref pert_bands_max as the
                    perturbation basis.
                }
                opt -val 'wannier' {
                    Use products of Wannier functions (read from the
                    Wannier90 files identified by @ref wannier_seedname)
                    as the perturbation basis.
                }
            }
        }

        var pert_bands_min -type INTEGER {
            default { 0 }
            see { pert_bands_max, pert_basis }
            info {
                Used only when @ref pert_basis = 'bands'. Minimum band
                index of the active space that defines the perturbations.
            }
        }

        var pert_bands_max -type INTEGER {
            default { 0 }
            see { pert_bands_min, pert_basis }
            info {
                Used only when @ref pert_basis = 'bands'. Maximum band
                index of the active space that defines the perturbations.
            }
        }

        var wannier_seedname -type CHARACTER {
            default { '' }
            see { pert_basis }
            info {
                Seedname of the Wannier90 calculation (files
                seedname.chk, seedname.eig, ...). Used only when
                @ref pert_basis = 'wannier', to construct the Wannier
                functions that define the perturbation basis.
            }
        }

        var folder_wan_Rr -type CHARACTER {
            default { outdir/HP<image> (i.e. tmp_dir_hp) }
            see { write_wan_Rr }
            info {
                Folder where the collected real-space Wannier functions
                are stored (files prefix.wan_Rr.xxx and prefix.wan_R.dat).
                If @ref write_wan_Rr = .true. this folder is created (if
                needed) and the Wannier functions are written to it.
                If @ref write_wan_Rr = .false. this folder must already
                exist and contain those files. If left empty, the
                image-specific scratch directory tmp_dir_hp
                (outdir/HP<image_id>) is used.
            }
        }

        var write_wan_Rr -type LOGICAL {
            default { .true. }
            see { folder_wan_Rr }
            info {
                If .true. the real-space Wannier functions are computed
                and written to @ref folder_wan_Rr. If .false. they are
                read back from @ref folder_wan_Rr (which must already
                contain the files prefix.wan_Rr.xxx and prefix.wan_R.dat).
            }
        }

        var wan_dist_thr -type REAL {
            default { 1.D-4 }
            dimensionality { length }
            units { bohr }
            see { wan_dist_thr_mels }
            info {
                Cutoff distance (in bohr) between the two Wannier-function
                centers of a pair, used to select the perturbations for
                the self-consistent response calculation. The number of
                DFPT perturbations is determined by this parameter.
                Used only when @ref pert_basis = 'wannier'. A small value
                such as 1.D-4 (with @ref wan_dist_thr_mels at its default)
                computes only the diagonal (density-density) interactions,
                provided no two Wannier functions share a center.
            }
        }

        var wan_dist_thr_mels -type REAL {
            default { same as @ref wan_dist_thr }
            dimensionality { length }
            units { bohr }
            see { wan_dist_thr }
            info {
                Cutoff distance (in bohr) between Wannier-function centers
                used when computing the Coulomb matrix elements (after the
                self-consistent response is available). It can be much
                larger than @ref wan_dist_thr with little extra cost, since
                it only affects the matrix-element evaluation. By default
                it equals @ref wan_dist_thr.
            }
        }

        var tr2 -type REAL {
            default { 1.D-20 }
            dimensionality { dimensionless }
            info {
                Convergence threshold for the iterative solution of the
                linear-response (Sternheimer) equations at each DFPT
                iteration.
            }
        }

        var lrpa -type LOGICAL {
            default { .false. }
            info {
                If .true. the exchange-correlation kernel is neglected in
                the response potential (dv_of_drho), i.e. the response is
                computed at the RPA (Hartree-only) level. If .false. the
                full (Hartree + exchange-correlation) response is used.
            }
        }

        var w_freq_eV -type COMPLEX {
            default { (0.d0, 0.d0) }
            dimensionality { energy }
            units { eV }
            info {
                Complex frequency at which the finite-frequency DFPT
                response is evaluated, in eV. The default (0,0) corresponds
                to the static response. Not available with @ref cdfpt.
            }
        }

        var diagonalization -type CHARACTER {
            default { 'david' }
            options {
                info {
                    Diagonalization method used in the non-self-consistent
                    (NSCF) calculation at k and k+q.
                }
                opt -val 'david' {
                    Davidson iterative diagonalization
                    ('davidson' is accepted as a synonym).
                }
                opt -val 'cg' {
                    Conjugate-gradient iterative diagonalization.
                }
            }
        }

        var conv_thr_nscf -type REAL {
            default { 1.D-9 }
            dimensionality { dimensionless }
            info {
                Convergence threshold for the eigenvalues of the
                non-self-consistent (NSCF) calculation at k and k+q. This
                is the cRPA counterpart of @ref ethr_nscf (which is used by
                the LR-cDFT method).
            }
        }

        var reduce_io -type LOGICAL {
            default { .false. }
            info {
                If .true. reduce the amount of I/O to disk (sets the
                internal io_level to 0), keeping more data in memory.
            }
        }

        var cdfpt -type LOGICAL {
            default { .false. }
            see { cdfpt_active_space }
            info {
                If .true. use constrained DFPT (cDFPT): the response of an
                "active space" is subtracted from the full susceptibility,
                so that the screening from the active states is excluded.
                The active space is specified by @ref cdfpt_active_space.
                Static DFPT only (@ref w_freq_eV = 0).
            }
        }

        var cdfpt_active_space -type CHARACTER {
            default { '' }
            see { cdfpt, cdfpt_bands_min, cdfpt_bands_max }
            info {
                Definition of the cDFPT active space (read only when
                @ref cdfpt = .true.).
            }
            options {
                opt -val 'bands' {
                    The active space is the set of bands from
                    @ref cdfpt_bands_min to @ref cdfpt_bands_max.
                }
                opt -val 'wannier' {
                    The active space is defined by Wannier functions.
                    @b Note: not yet implemented (the code stops if
                    requested).
                }
            }
        }

        var cdfpt_bands_min -type INTEGER {
            default { 0 }
            see { cdfpt_active_space }
            info {
                Minimum band index of the cDFPT active space. Used only
                when @ref cdfpt = .true. and @ref cdfpt_active_space =
                'bands' (must be >= 1 in that case).
            }
        }

        var cdfpt_bands_max -type INTEGER {
            default { 0 }
            see { cdfpt_active_space }
            info {
                Maximum band index of the cDFPT active space. Used only
                when @ref cdfpt = .true. and @ref cdfpt_active_space =
                'bands' (must be >= @ref cdfpt_bands_min).
            }
        }

        var qplot -type LOGICAL {
            default { .false. }
            info {
                If .true. the list of q points is read from the q-point
                card that follows the @b &CRPA namelist, instead of being
                generated from the (@ref nq1, @ref nq2, @ref nq3)
                Monkhorst-Pack grid.
            }
        }

    }

    card qPointsSpecs {
        label {
            Optional q-point card, read (right after the @b &CRPA namelist)
            only when @ref qplot = .true. Used only for @ref method = 'cRPA';
            method = 'LR-cDFT' does not read it.
        }
        syntax {
            line {
                var nqaux -type INTEGER {
                    info {
                        Number of q points in the list below.
                    }
                }
            }
            table qPoints {
                rows -start 1 -end nqaux {
                    colgroup -type REAL {
                        info {
                            q-point coordinates, in units of 2pi/a0
                            (a0 = lattice parameter).
                        }
                        col xq1
                        col xq2
                        col xq3
                    }
                    col wq -type INTEGER {
                        info {
                            Weight of the q point (integer). Currently
                            read but not used (each q point is treated
                            explicitly).
                        }
                    }
                }
            }
        }
    }

}
